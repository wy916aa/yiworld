   '<button class="btn small" id="addE">记上</button></div></div>';

  h+='<div class="card"><h2>分类</h2>';
  CATS.forEach(c=>{
    const v=by[c]||0; if(!v)return;
    const w=Math.min(100,Math.round(v/Math.max(1,spent)*100));
    h+='<div style="margin:6px 0"><div class="row" style="justify-content:space-between">'+
     '<span>'+c+'</span><span class="muted">'+v+' 元</span></div>'+
     '<div class="bar"><i style="width:'+w+'%"></i></div></div>';
