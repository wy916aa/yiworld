<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#f6f5f2">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="YiWorld">
<title>YiWorld · 我的世界</title>
<style>
:root{--bg:#f6f5f2;--card:#fff;--ink:#1f2421;--muted:#8a8f8b;--line:#e6e4df;
  --accent:#2f5d50;--soft:#e8efeb;--warn:#b4632f}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;background:var(--bg);color:var(--ink)}
body{font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;
  font-size:15px;line-height:1.6;padding:16px 14px 90px;max-width:560px;margin:0 auto}
h1{font-size:21px;margin:0}
.sub{color:var(--muted);font-size:12.5px;margin:2px 0 14px}
.tabs{display:flex;gap:6px;background:#eceae5;border-radius:12px;padding:4px;margin-bottom:14px}
.tabs button{flex:1;border:0;background:transparent;padding:9px 0;border-radius:9px;
  font-size:14px;color:#555;font-family:inherit;cursor:pointer}
.tabs button.on{background:#fff;color:var(--ink);font-weight:600;box-shadow:0 1px 3px rgba(0,0,0,.07)}
.card{background:var(--card);border-radius:16px;padding:14px 14px 10px;margin-bottom:12px;
  box-shadow:0 1px 2px rgba(0,0,0,.04),0 6px 16px rgba(0,0,0,.03)}
.card h2{font-size:13px;margin:0 0 8px;color:var(--muted);font-weight:500;letter-spacing:.4px}
.task{display:flex;gap:11px;padding:10px 0;border-bottom:1px solid var(--line);align-items:flex-start}
.task:last-child{border-bottom:0}
.box{width:21px;height:21px;flex:0 0 21px;border-radius:6px;border:1.5px solid #cfccc5;
  margin-top:2px;display:flex;align-items:center;justify-content:center;cursor:pointer}
.task.done .box{background:var(--accent);border-color:var(--accent)}
.box svg{opacity:0}
.task.done .box svg{opacity:1}
.task.done .t{color:var(--muted);text-decoration:line-through}
.t{font-size:15px}
.meta{font-size:12px;color:var(--muted);margin-top:2px}
.tip{font-size:12.5px;color:#4d6b60;margin-top:3px}
.mins{font-size:12px;color:var(--warn)}
.progress{display:flex;align-items:center;gap:9px;margin-top:6px}
.bar{flex:1;height:6px;background:var(--line);border-radius:99px;overflow:hidden}
.bar i{display:block;height:100%;width:0;background:var(--accent);transition:.25s}
.pct{font-size:12px;color:var(--muted);min-width:38px;text-align:right}
.grid{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;margin-top:4px}
.wd{text-align:center;font-size:11px;color:var(--muted);padding:2px 0}
.cell{aspect-ratio:1;border-radius:9px;display:flex;flex-direction:column;align-items:center;
  justify-content:center;font-size:12.5px;cursor:pointer;background:#faf9f7;position:relative}
.cell.empty{background:transparent;cursor:default}
.cell .n{line-height:1.1}
.cell .dot{width:4px;height:4px;border-radius:99px;background:#cfccc5;margin-top:3px}
.cell.l1 .dot{background:#a8c3b9}
.cell.l2 .dot{background:#79a292}
.cell.l3 .dot{background:var(--accent)}
.cell.today{outline:1.5px solid var(--accent)}
.cell.sel{background:var(--soft)}
.cell.future{opacity:.45}
.stats{display:flex;gap:8px;margin-top:12px}
.stat{flex:1;background:#faf9f7;border-radius:10px;padding:8px;text-align:center}
.stat b{display:block;font-size:17px;color:var(--accent)}
.stat span{font-size:11px;color:var(--muted)}
.btn{border:0;border-radius:10px;padding:10px 14px;font-size:14px;font-family:inherit;
  background:var(--accent);color:#fff;cursor:pointer}
.btn.ghost{background:#f0eee9;color:#444}
.btn.small{padding:7px 11px;font-size:13px}
.row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
textarea,input,select{font-family:inherit;font-size:14px;padding:9px 10px;border:1px solid var(--line);
  border-radius:9px;background:#fff;color:var(--ink);width:100%}
textarea{min-height:96px;resize:vertical;line-height:1.5}
label.f{display:block;font-size:12px;color:var(--muted);margin:8px 0 3px}
.chips{display:flex;gap:6px;flex-wrap:wrap;margin-top:4px}
.chip{font-size:12.5px;padding:5px 10px;border-radius:99px;background:#f0eee9;color:#555;cursor:pointer}
.chip.on{background:var(--accent);color:#fff}
.muted{color:var(--muted);font-size:12.5px}
.hidden{display:none}
.toast{position:fixed;left:50%;transform:translateX(-50%);bottom:24px;background:#1f2421;color:#fff;
  padding:11px 16px;border-radius:12px;font-size:13.5px;max-width:88%;z-index:99;
  box-shadow:0 8px 24px rgba(0,0,0,.2);opacity:0;pointer-events:none;transition:.2s}
.toast.on{opacity:1;bottom:34px}
.itemrow{display:flex;justify-content:space-between;gap:8px;padding:9px 0;border-bottom:1px solid var(--line)}
.itemrow:last-child{border-bottom:0}
.x{color:var(--muted);font-size:13px;cursor:pointer;padding:0 4px;white-space:nowrap;flex:0 0 auto}
.rose{color:#a4556b}
.big{font-size:30px;font-weight:600;line-height:1.2;margin:4px 0}
.banner{background:#fbeeee;border:1px solid #f0d6dc;color:#8a4356;border-radius:14px;
  padding:12px 14px;margin-bottom:12px;font-size:13.5px}
.banner b{font-size:15px}
.setrow{display:flex;gap:8px;align-items:center;margin-top:8px}
.setrow input{flex:1}
.hist{font-size:12.5px;color:var(--muted);margin-top:8px;line-height:1.8}
.pbtn{background:#a4556b}
</style>
<style>
/* ---- cute theme ---- */
:root{
  --bg:#FFF7EC; --card:#FFFCF6; --ink:#5B4032; --muted:#A98F7C; --line:#F2DFC8;
  --accent:#F09A76; --soft:#FDEEDD; --warn:#D9734B;
  --brown:#8B5E3C; --green:#9DBE8C; --rose:#E98FA5;
}
html,body{background:#FFF7EC}
body{
  background-image:repeating-linear-gradient(90deg,#FFF7EC 0 34px,#FDF1E1 34px 68px);
  background-attachment:fixed;
  padding:18px 14px 108px; color:var(--ink);
}
h1{color:var(--brown);font-size:22px;letter-spacing:.5px}
.sub{color:#B79A83}
.mascot{font-size:20px;margin-left:4px}
.card{
  background:var(--card);border:1px solid #F3E2CD;border-radius:20px;
  box-shadow:0 6px 16px rgba(176,132,92,.10),0 1px 0 #fff inset;
  padding:16px 15px 12px;
}
.card h2{color:#B08A6C;font-size:12.5px;letter-spacing:1px}
.task{border-bottom:1px dashed #F2E3D2}
.task .t{font-weight:500}
.box{border:2px solid #E7CDB2;border-radius:8px;background:#FFFDF9}
.task.done .box{background:var(--green);border-color:var(--green)}
.task.done .t{color:#B9A695}
.meta{color:#B79A83}
