.cell.l3 .dot{background:#C97C55}
.stat{background:#FBF3E7}
.stat b{color:#8B5E3C}
.btn{
  background:linear-gradient(180deg,#F7B08E,#EE9670);color:#fff;font-weight:600;
  border:2px solid #FFF3E6;box-shadow:0 3px 0 #D98A66;border-radius:14px;
}
.btn:active{transform:translateY(2px);box-shadow:0 1px 0 #D98A66}
.btn.ghost{background:#FBF1E4;color:#7E6552;box-shadow:0 3px 0 #EAD7C2;border-color:#FFF8EF}
.chip{background:#FBF1E4;color:#7E6552;border:1px solid #F0DDC7}
.chip.on{background:var(--accent);color:#fff;border-color:var(--accent)}
input,textarea,select{border:1.5px solid #F0DDC7;background:#FFFDF9;color:var(--ink);border-radius:12px}
input:focus,textarea:focus{outline:none;border-color:var(--accent)}
.toast{background:#6B4F3C;border-radius:16px}
.itemrow{border-bottom:1px dashed #F2E3D2}
.x{color:#C0A98F}
.banner{background:#FFF0F3;border:1px solid #F6D6DE;color:#A4526A;border-radius:16px;font-weight:500}
.pbtn{background:linear-gradient(180deg,#F0A3B6,#E4819B);box-shadow:0 3px 0 #C96B85;border-color:#FFF0F4}
/* bottom nav */
.tabs{
  position:fixed;left:50%;transform:translateX(-50%);bottom:10px;
  width:calc(100% - 20px);max-width:540px;
  display:flex;gap:2px;background:rgba(255,251,244,.97);
  border:1px solid #F0DDC7;border-radius:22px;padding:6px;
  box-shadow:0 8px 26px rgba(150,110,75,.16);z-index:50;
}
.tabs button{
  flex:1;display:flex;flex-direction:column;align-items:center;gap:1px;
  background:transparent;border-radius:16px;padding:7px 0 6px;font-size:11px;color:#AE9682;
}
.tabs button i{font-style:normal;font-size:19px;line-height:1.1}
.tabs button.on{background:#FDEEDD;color:#8B5E3C;font-weight:700}
.pop{
  position:fixed;left:50%;top:10px;transform:translate(-50%,-130%);
  width:calc(100% - 24px);max-width:420px;z-index:200;
  background:#FFFCF6;border:2px solid #F3DFC6;border-radius:22px;
  box-shadow:0 14px 34px rgba(150,110,75,.28);
  padding:14px 14px 12px;transition:transform .38s cubic-bezier(.2,.9,.3,1.25);
}
.pop.on{transform:translate(-50%,0)}
.pop .head{display:flex;gap:10px;align-items:center}
.pop .ava{font-size:30px;line-height:1}
.pop .ttl{font-weight:700;color:#8B5E3C;font-size:15px}
.pop .sub2{font-size:12.5px;color:#A98F7C;margin-top:2px}
.pop .acts{display:flex;gap:8px;margin-top:12px}
.pop .acts button{flex:1;border:0;font-family:inherit;font-size:13px;padding:9px 0;border-radius:13px}
.pop .acts .later{background:#F7ECDD;color:#8B6A4F}
.pop .acts .ok{background:linear-gradient(180deg,#A9C79A,#8DAE7C);color:#fff;font-weight:700}
</style>
</head>
<body>

<h1>YiWorld<span class="mascot">🐻</span></h1>
<div class="sub" style="margin-top:-2px">我的世界 · 只属于我的一点点秩序</div>
<div class="sub" id="sub"></div>

<div class="tabs">
  <button data-v="today" class="on"><i>☀️</i>今天</button>
  <button data-v="month"><i>📅</i>打卡</button>
  <button data-v="health"><i>🌸</i>身体</button>
  <button data-v="classes"><i>📚</i>计划</button>
  <button data-v="money"><i>💰</i>账本</button>
</div>

<section id="v-today"></section>
<section id="v-month" class="hidden"></section>
<section id="v-health" class="hidden"></section>
<section id="v-classes" class="hidden"></section>
<section id="v-money" class="hidden"></section>

<div class="toast" id="toast"></div>

<div class="pop" id="pop">
  <div class="head">
    <div class="ava" id="popAva">🐻</div>
    <div><div class="ttl" id="popTitle">该做点事了</div>
      <div class="sub2" id="popSub"></div></div>
  </div>
  <div class="acts">
    <button class="later" id="popLater">10 分钟后再提醒</button>
    <button class="ok" id="popDone">做完了</button>
  </div>
</div>

<script>
const KEY='plan_v2';
const WD=['周日','周一','周二','周三','周四','周五','周六'];
const SEM_START='2026-09-07'; // 第一周周一
const SEED_CLASSES=[
 {id:'k1',title:'大学英语（预备）',days:[1],start:'15:05',end:'16:40',where:'恕园11号楼',w1:2,w2:17},
 {id:'k2',title:'武术拳',days:[1],start:'13:20',end:'14:55',where:'操场',w1:13,w2:17},
 {id:'k3',title:'基础化学CI',days:[3],start:'08:05',end:'09:35',where:'恕园8号楼306',w1:1,w2:8},
 {id:'k4',title:'护士人文修养',days:[3],start:'13:20',end:'15:50',where:'恕园13号楼101',w1:6,w2:9},
 {id:'k5',title:'护理学导论',days:[4],start:'08:05',end:'11:25',where:'恕园11号楼',w1:1,w2:8},
 {id:'k6',title:'思想道德与法治',days:[4],start:'13:20',end:'15:50',where:'恕园10号楼102',w1:11,w2:16},
 {id:'k7',title:'人工智能与医疗健康',days:[4],start:'18:00',end:'20:25',where:'恕园10号楼104',w1:2,w2:10},
 {id:'k8',title:'人体形态学',days:[5],start:'08:05',end:'10:30',where:'恕园10号楼104',w1:2,w2:7},
 {id:'k9',title:'京剧艺术赏析',days:[5],start:'18:00',end:'20:25',where:'恕园9号楼203',w1:2,w2:9},
 {id:'k10',title:'新中国史',days:[6],start:'18:00',end:'19:35',where:'恕园9号楼',w1:5,w2:13}
];
const TIPS={
  '化学':['先做一道，再看下一道。','卡住的那一步就是今天的任务。','不用学完，做出来就行。'],
  '解剖':['合上书先说出来，比再看一遍有用。','两分钟也算数。'],
  '期中':['先写一百字，剩下的会自己长出来。','提纲写出来，就完成一半了。'],
  '愿望':['先做出来，再谈好不好。','六十秒也算一条。'],
  '体态':['三分钟也算数。','频率比强度重要。'],
  '睡':['现在躺下，明天才有得选。'],
  '跑':['跑完顺路洗澡，一条线。']
};
const DEFAULT_TIPS=['做不到完整版，就做最小版。','开始了就已经赢过昨天。','今天只推这一件。'];

function seed(){
  return {tasks:[
    {id:'t1',title:'化学作业 1-2 题',days:[1],time:'19:00',dur:40,min:'至少 1 题',tip:'圈出卡住的那一步，只搜那一个点。'},
    {id:'t2',title:'解剖回忆',days:[2],time:'19:00',dur:30,min:'开口说 2 分钟',tip:'合上书先说出来，再翻书补漏。'},
    {id:'t3',title:'化学作业 1-2 题',days:[3],time:'19:00',dur:40,min:'至少 1 题',tip:'先做一道，再看下一道。'},
    {id:'t4',title:'期中作业提纲',days:[4],time:'21:00',dur:30,min:'写 100 字',tip:'晚课回来洗完澡再写，写一百字就停。'},
    {id:'t5',title:'愿望：文游或 vlog',days:[5],time:'21:00',dur:60,min:'30 分钟',tip:'先做出来，再谈好不好。'},
    {id:'t6',title:'愿望两小时',days:[6],time:'10:00',dur:120,min:'休息也算',tip:'一周只推一件。'},
    {id:'t7',title:'解剖回忆',days:[0],time:'19:00',dur:30,min:'开口说 2 分钟',tip:'两分钟也算数。'},
    {id:'t8',title:'体态三分钟',days:[0,1,2,3,4,5,6],time:'22:30',dur:5,min:'靠墙站 1 分钟',tip:'频率比强度重要。'}  ,
    {id:'t9',title:'23:30 躺下',days:[0,1,2,3,4,5,6],time:'23:30',dur:5,min:'躺着也算',tip:'现在躺下，明天才有得选。'}
  ],logs:{},notify:false,period:{last:'',cycle:28,before:3,history:[]}};
}

let S=load();
function load(){
  let st=null;
  try{const r=localStorage.getItem(KEY);if(r)st=JSON.parse(r);}catch(e){}
  if(!st) st=seed();
  if(!st.period) st.period={last:'',cycle:28,before:3,history:[]};
  if(!st.classes) st.classes=[];
  if(!st.seedV){ st.classes=SEED_CLASSES.slice(); st.seedV=1; }
  if(!st.money) st.money={allowance:0,savedGoal:0,entries:[]};
  return st;
}
function save(){try{localStorage.setItem(KEY,JSON.stringify(S));}catch(e){}}

const today=new Date();
function key(d){return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');}
const TK=key(today);
function logOf(k){ if(!S.logs[k]) S.logs[k]={}; return S.logs[k]; }

function tasksOn(d){
  const w=d.getDay(), k=key(d);
  return S.tasks.filter(t=>t.date?t.date===k:(t.days||[]).includes(w))
    .sort((a,b)=>(a.time||'').localeCompare(b.time||''));
}
function tipFor(t){
  if(t.tip) return t.tip;
  for(const k in TIPS){ if(t.title.includes(k)) return TIPS[k][0]; }
  return DEFAULT_TIPS[0];
}

function renderToday(){
  const list=tasksOn(today), lg=logOf(TK);
  const done=list.filter(t=>lg[t.id]).length;
  const pct=list.length?Math.round(done/list.length*100):0;
  let html='<div class="card"><h2>今天的清单</h2>';
  if(!list.length) html+='<div class="muted">今天没有安排。休息也是计划的一部分。</div>';
  list.forEach(t=>{
    html+='<div class="task'+(lg[t.id]?' done':'')+'" data-id="'+t.id+'">'+
      '<div class="box"><svg width="12" height="12" viewBox="0 0 24 24" fill="none">'+
      '<path d="M4 12.5l5 5L20 6.5" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></div>'+
      '<div style="flex:1"><div class="t">'+esc(t.title)+'</div>'+
      '<div class="meta">'+t.time+'　<span class="mins">约 '+t.dur+' 分钟</span>'+
      (t.min?'　最小版：'+esc(t.min):'')+'</div>'+
      '<div class="tip">'+esc(tipFor(t))+'</div></div></div>';
  });
  html+='<div class="progress"><div class="bar"><i style="width:'+pct+'%"></i></div>'+
    '<div class="pct">'+done+' / '+list.length+'</div></div></div>';
  const wd=today.getDay();
  const free=(wd===0||wd===6)?'14:00–16:00':'22:00–22:30';
  html+='<div class="card"><h2>今天的自由时间</h2><div class="muted">'+free+
    ' 是你的，不用有负罪感。约定只有一条：这一集看完就停。</div></div>';
  document.getElementById('v-today').innerHTML=html;
  document.querySelectorAll('#v-today .box').forEach(b=>{
    b.onclick=()=>{ const id=b.closest('.task').dataset.id; lg[id]=!lg[id]; save(); renderToday(); };
  });
}

let viewYear=today.getFullYear(), viewMonth=today.getMonth(), selDay=key(today);
function renderMonth(){
  const first=new Date(viewYear,viewMonth,1);
  const start=first.getDay(); // 0=Sun
  const days=new Date(viewYear,viewMonth+1,0).getDate();
  let cells='';
  for(let i=0;i<start;i++) cells+='<div class="cell empty"></div>';
  let totalDone=0,totalTasks=0,best=0,run=0;
  for(let d=1;d<=days;d++){
    const dt=new Date(viewYear,viewMonth,d), k=key(dt);
    const list=tasksOn(dt), lg=S.logs[k]||{};
    const done=list.filter(t=>lg[t.id]).length;
    if(dt<=today){ totalTasks+=list.length; totalDone+=done;
      if(list.length&&done===list.length){run++;best=Math.max(best,run);}else if(list.length){run=0;} }
    const lvl=list.length?Math.round(done/list.length*3):0;
    const cls=['cell'];
    if(k===key(today)) cls.push('today');
    if(k===selDay) cls.push('sel');
    if(dt>today) cls.push('future');
    cls.push('l'+(done===0?0:lvl>=3?3:lvl>=2?2:1));
    cells+='<div class="'+cls.join(' ')+'" data-k="'+k+'"><span class="n">'+d+'</span>'+
      (list.length?'<span class="dot"></span>':'')+'</div>';
  }
  const rate=totalTasks?Math.round(totalDone/totalTasks*100):0;
  let wTotal=0,wDone=0,miss={};
  for(let i=0;i<7;i++){
    const dd=addDays(today,-i), kk=key(dd), list=tasksOn(dd), lg2=S.logs[kk]||{};
    list.forEach(t=>{wTotal++; if(lg2[t.id])wDone++; else miss[t.title]=(miss[t.title]||0)+1;});
  }
  const wRate=wTotal?Math.round(wDone/wTotal*100):0;
  let worst='',wn=0;
  for(const k2 in miss){ if(miss[k2]>wn){wn=miss[k2];worst=k2;} }
  const advice = wRate>=80?'状态不错，可以只加一件新的。'
    : wRate>=50?'把最常断的那件拆成更小的版本。'
    : '先只保三件：23:30 躺下、洗澡、做一件最小的。';
  const selList=tasksOn(new Date(selDay+'T00:00:00')), selLog=S.logs[selDay]||{};
