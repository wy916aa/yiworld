/* ---------- 导出 iPhone 日历 ---------- */
function p2(n){return String(n).padStart(2,'0');}
function icsDT(d,h,m){return d.getFullYear()+p2(d.getMonth()+1)+p2(d.getDate())+'T'+p2(h)+p2(m)+'00';}
function nextDOW(dow){
  const d=new Date(today.getFullYear(),today.getMonth(),today.getDate());
  d.setDate(d.getDate()+((dow-d.getDay()+7)%7));
  return d;
}
function iesc(s){
  return String(s||'').replace(/\\/g,'\\\\').replace(/;/g,'\\;').replace(/,/g,'\\,')
    .replace(/\r?\n/g,'\\n');
}
const BYDAY=['SU','MO','TU','WE','TH','FR','SA'];
function buildICS(){
  const now=new Date();
  const stamp=icsDT(now,now.getHours(),now.getMinutes());
  const L=['BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//MyPlan//CN',
    'CALSCALE:GREGORIAN','METHOD:PUBLISH','X-WR-CALNAME:我的日程'];
  S.tasks.forEach(t=>{
    const days=(t.days||[]).slice().sort();
    if(!days.length) return;
    const base=nextDOW(days[0]);
    const [hh,mm]=(t.time||'20:00').split(':');
    L.push('BEGIN:VEVENT');
    L.push('UID:'+t.id+'@myplan');
    L.push('DTSTAMP:'+stamp);
    L.push('DTSTART:'+icsDT(base,+hh,+mm));
    L.push('DURATION:PT'+(t.dur||30)+'M');
    L.push('RRULE:FREQ=WEEKLY;BYDAY='+days.map(d=>BYDAY[d]).join(','));
    L.push('SUMMARY:'+iesc(t.title));
    L.push('DESCRIPTION:'+iesc((t.min?('最小版：'+t.min+'\\n'):'')+tipFor(t)));
    [0,5,15].forEach(m=>{
      const msg=(m===0?'该做了':m===5?'开始了吗？':'已经 15 分钟了')+'：'+t.title;
      L.push('BEGIN:VALARM');
      L.push('TRIGGER:PT'+m+'M');
      L.push('ACTION:DISPLAY');
      L.push('DESCRIPTION:'+iesc(msg));
      L.push('END:VALARM');
    });
    L.push('END:VEVENT');
  });
  const pi=periodInfo();
  if(pi&&pi.next){
    L.push('BEGIN:VEVENT');
    L.push('UID:period@myplan');
    L.push('DTSTAMP:'+stamp);
    L.push('DTSTART;VALUE=DATE:'+pi.next.getFullYear()+p2(pi.next.getMonth()+1)+p2(pi.next.getDate()));
    L.push('SUMMARY:'+iesc('经期预计开始'));
    L.push('DESCRIPTION:'+iesc('按 '+((S.period&&S.period.cycle)||28)+' 天周期预测，仅供参考'));
    L.push('BEGIN:VALARM');
    L.push('TRIGGER:PT9H');
    L.push('ACTION:DISPLAY');
    L.push('DESCRIPTION:'+iesc('经期可能到了，注意休息'));
    L.push('END:VALARM');
    L.push('END:VEVENT');
  }
  L.push('END:VCALENDAR');
  return L.join('\r\n');
}
function downloadICS(){
  const blob=new Blob([buildICS()],{type:'text/calendar;charset=utf-8'});
  const a=document.createElement('a');
  a.href=URL.createObjectURL(blob);
