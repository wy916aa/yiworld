  if(!spent) h+='<div class="muted">这个月还没有记录。</div>';
  h+='</div>';

  if(list.length){
    h+='<div class="card"><h2>最近</h2>';
    list.slice().reverse().slice(0,12).forEach(e=>{
      h+='<div class="itemrow"><div><div>'+esc(e.note||e.cat)+'</div>'+
       '<div class="meta">'+(e.date||'')+'　'+e.cat+'</div></div>'+
       '<div class="row"><span>'+e.amount+' 元</span><span class="x" data-dele="'+e.id+'">删</span></div></div>';
    });
    h+='</div>';
  }
  document.getElementById('v-money').innerHTML=h;

  document.getElementById('allow').onchange=e=>{S.money.allowance=+e.target.value||0;save();renderMoney();};
  document.getElementById('sgoal').onchange=e=>{S.money.savedGoal=+e.target.value||0;save();renderMoney();};
  document.getElementById('addE').onclick=()=>{
    const a=+document.getElementById('amt').value;
    if(!a){toast('先填金额');return;}
    const note=document.getElementById('note').value.trim();
    S.money.entries.push({id:'e'+Date.now(),date:key(today),amount:a,
      cat:document.getElementById('cat').value,note});
    save(); renderMoney(); toast('记上了');
  };
  document.querySelectorAll('[data-dele]').forEach(x=>{
    x.onclick=()=>{S.money.entries=S.money.entries.filter(e=>e.id!==x.dataset.dele);save();renderMoney();};
  });
}

const fired={};
const STAGES=[0,5,15,30];
function tick(){
  const now=new Date(), todayK=key(now);
  const nowMin=now.getHours()*60+now.getMinutes();
  const lg=logOf(todayK);

  tasksOn(now).forEach(t=>{
    if(lg[t.id]) return;
    const delta=nowMin-T(t.time);
    if(delta<0) return;
    let fire=null;
    STAGES.forEach(m=>{ const k=todayK+'|'+t.id+'|'+m;
      if(delta>=m && !fired[k] && fire===null) fire=m; });
    if(fire===null) return;
    STAGES.forEach(m=>{ if(m<=fire) fired[todayK+'|'+t.id+'|'+m]=1; });
    const msg = fire===0 ? '该做了' : fire===5 ? '开始了吗？' : fire===15 ? '已经过了 15 分钟' : '再不做就来不及了';
    showReminder(t,msg);
    if('Notification' in window && Notification.permission==='granted'){
      try{new Notification(msg,{body:t.title+(t.min?('　最小版：'+t.min):'')});}catch(e){}
    }
  });

  const pi=periodInfo();
  if(pi && !fired['period|'+todayK]){
    const before=(S.period.before==null?3:S.period.before);
    if(pi.days<=before){
      fired['period|'+todayK]=1;
      vibrate([400,200,400]);
      toast(pi.days>0?('快到了，还有 '+pi.days+' 天'):pi.days===0?'今天可能到':'已经晚了，记得记录');
      if('Notification' in window && Notification.permission==='granted'){
        try{new Notification('经期提醒',{body:pi.days>0?('预计还有 '+pi.days+' 天'):'今天可能到，注意休息'});}catch(e){}
      }
    }
  }
}
setInterval(tick,20000);

document.querySelectorAll('.tabs button').forEach(b=>{
  b.onclick=()=>{
    document.querySelectorAll('.tabs button').forEach(x=>x.classList.remove('on'));
    b.classList.add('on');
    ['today','month','health','classes','money'].forEach(v=>{
      document.getElementById('v-'+v).classList.toggle('hidden',v!==b.dataset.v);
    });
    if(b.dataset.v==='month') renderMonth();
    if(b.dataset.v==='health') renderHealth();
    if(b.dataset.v==='classes') renderClasses();
    if(b.dataset.v==='money') renderMoney();
  };
});

