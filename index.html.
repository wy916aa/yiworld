   '<div class="big" style="color:'+(left<0?'#C25E4A':'#8B5E3C')+'">'+(allow?('剩 '+left+' 元'):'先填生活费')+'</div>'+
   '<div class="muted">已花 '+spent+' 元'+(allow?('　建议存 '+Math.round(allow*0.15)+' 元'):'')+'</div></div>';

