.day,.cell{background:#FBF3E7;border-radius:12px}
.cell.today{outline:2px solid var(--accent);outline-offset:-2px;background:#FFF4E4}
.cell.sel{background:#FFEBD6}
.cell.l1 .dot{background:#F3CBB0}
