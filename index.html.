    h+='<div class="card"><h2>经期</h2><div class="big rose">'+txt+'</div>'+
      '<div class="muted">预计 '+fmtDate(info.next)+'　周期 '+(p.cycle||28)+' 天　提前 '+(p.before||3)+' 天提醒</div>'+
      '<div class="row" style="margin-top:12px"><button class="btn pbtn small" id="periodNow">今天来了</button></div></div>';
  } else {
    h+='<div class="card"><h2>经期</h2><div class="muted">设置一次上次开始的日期，之后就能预测和提醒。</div></div>';
  }
  h+='<div class="card"><h2>设置</h2>'+
    '<label class="f">上次开始的日期</label><input type="date" id="pLast" value="'+(p.last||'')+'">'+
    '<div class="setrow"><div style="flex:1"><label class="f">周期（天）</label>'+
    '<input type="number" id="pCycle" value="'+(p.cycle||28)+'" min="18" max="60"></div>'+
    '<div style="flex:1"><label class="f">提前几天提醒</label>'+
    '<input type="number" id="pBefore" value="'+(p.before||3)+'" min="0" max="10"></div></div>'+
    '<div class="row" style="margin-top:10px"><button class="btn small" id="pSave">保存</button></div></div>';
  const hist=(p.history||[]).slice(-6);
  if(hist.length){
    h+='<div class="card"><h2>最近记录</h2><div class="hist">'+
      hist.map((d,i)=>{
        const prev=hist[i-1];
        const gap=prev?Math.round((parseD(d)-parseD(prev))/86400000):null;
        return d+(gap?'　间隔 '+gap+' 天':'');
      }).join('<br>')+'</div></div>';
  }
  h+='<div class="muted" style="padding:0 4px">记录只存在这台设备上，不会上传。</div>';
  document.getElementById('v-health').innerHTML=h;

  const save=()=>{
    S.period.last=document.getElementById('pLast').value||S.period.last;
    S.period.cycle=+document.getElementById('pCycle').value||28;
    S.period.before=+document.getElementById('pBefore').value||3;
    saveS(); renderHealth(); renderToday(); toast('已保存');
  };
  document.getElementById('pSave').onclick=save;
  const nowBtn=document.getElementById('periodNow');
  if(nowBtn) nowBtn.onclick=()=>{
    const k=key(today);
    S.period.history=S.period.history||[];
    if(!S.period.history.includes(k)) S.period.history.push(k);
    S.period.last=k; saveS(); renderHealth(); renderToday(); toast('已记录今天');
  };
}
