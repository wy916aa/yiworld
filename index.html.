function parseGoal(text){
  let s=' '+text+' ';
  let dur=0, days=null, count=1, hint=null;
  let m;
  m=s.match(/(\d+)\s*分钟/); if(m){dur=+m[1]; s=s.replace(m[0],' ');}
  if(!dur){ m=s.match(/(半|一|两|二|\d+(?:\.\d+)?)\s*个?\s*小时/);
    if(m){const v={'半':.5,'一':1,'两':2,'二':2}[m[1]]||parseFloat(m[1])||1;dur=Math.round(v*60);s=s.replace(m[0],' ');} }
  if(/每天|天天/.test(s)){days=[0,1,2,3,4,5,6];s=s.replace(/每天|天天/g,' ');}
  else if(/工作日/.test(s)){days=[1,2,3,4,5];s=s.replace(/工作日/g,' ');}
  else if(/周末/.test(s)){days=[0,6];s=s.replace(/周末/g,' ');}
  else {
    const dm=[...s.matchAll(/周([一二三四五六日天])/g)];
    if(dm.length){days=[...new Set(dm.map(x=>DAYMAP[x[1]]))];dm.forEach(x=>s=s.replace(x[0],' '));}
  }
  m=s.match(/(\d+)\s*次/); if(m){count=+m[1]; s=s.replace(m[0],' ');}
  m=s.match(/(早上|上午|中午|下午|晚上)?\s*(\d{1,2})\s*[:：点]\s*(\d{1,2})?/);
  if(m){
    let hh=+m[2]; const mm=m[3]?+m[3]:0;
    if(/下午|晚上/.test(m[1]||'')&&hh<12) hh+=12;
    hint=hh*60+mm; s=s.replace(m[0],' ');
  }
  const title=s.replace(/[，。、；,;：:]/g,' ').replace(/\s+/g,' ').trim()||'新任务';
  return {title,dur:dur||40,days,count,hint};
}

function busyOf(day){
  const arr=[];
  S.classes.filter(c=>(c.days||[]).includes(day)&&activeNow(c)).forEach(c=>arr.push([T(c.start),T(c.end)]));
  S.tasks.filter(t=>(t.days||[]).includes(day)).forEach(t=>{
    const s=T(t.time); if(s>0) arr.push([s,s+(t.dur||30)]);
  });
  return arr;
}
function freeStart(day,dur,hint){
  const busy=busyOf(day), tries=[];
  if(hint!=null) tries.push(hint);
  const weekend=(day===0||day===6);
  let t=weekend?9*60:19*60;
  for(;t<=22*60;t+=15) tries.push(t);
  for(const s of tries){
    if(s<7*60||s+dur>23*60+30) continue;
    const ok=busy.every(([b,e])=>s+dur<=b||s>=e);
    if(ok) return s;
  }
  return null;
}
function autoPlan(g){
  const days=g.days||[today.getDay()];
  const made=[];
  for(let i=0;i<g.count;i++){
    const day=days[i%days.length];
    const slot=freeStart(day,g.dur,g.hint);
    if(slot==null) continue;
    const id='g'+Date.now()+Math.random().toString(16).slice(2);
    S.tasks.push({id,title:g.title,days:[day],time:H(slot),dur:g.dur,min:'做 '+Math.max(5,Math.round(g.dur/2))+' 分钟',tip:''});
    made.push(WD[day]+' '+H(slot)+'　'+g.title+'（'+g.dur+' 分钟）');
  }
  return made;
}

/* ---------- 一句话指令 ---------- */
function findTasks(key){
  key=(key||'').trim();
  if(!key) return [];
  return S.tasks.filter(x=>x.title.includes(key)||key.includes(x.title));
}
function applyCommand(text){
  const t=text.trim(), out=[];
  let m;

  m=t.match(/(?:删除|删掉|去掉)\s*(.+)/);
  if(m){
    const hit=findTasks(m[1]);
    if(hit.length){ S.tasks=S.tasks.filter(x=>!hit.includes(x)); save(); renderClasses(); }
    return hit.length?['已删除：'+hit.map(x=>x.title).join('、')]:['没找到「'+m[1].trim()+'」'];
  }

  m=t.match(/(?:完成|打卡)\s*(.+)/);
  if(m){
    const k=m[1].trim();
    const list=tasksOn(today).filter(x=>x.title.includes(k));
    if(list.length){ const lg=logOf(TK); list.forEach(x=>lg[x.id]=true); save(); renderToday(); }
    return list.length?['已打勾：'+list.map(x=>x.title).join('、')]:['今天没有「'+k+'」'];
  }

  m=t.match(/(?:把)?(.+?)(?:改到|改成|改为)\s*(\d{1,2})\s*[点:：]?\s*(\d{0,2})/);
  if(m){
    const k=m[1].trim(); let hh=+m[2]; const mm=m[3]?+m[3]:0;
    if(hh<7) hh+=12;
    const list=findTasks(k);
    if(list.length){
      const tm=String(hh).padStart(2,'0')+':'+String(mm).padStart(2,'0');
      list.forEach(x=>x.time=tm); save(); renderClasses();
      return ['已改到 '+tm+'：'+list.map(x=>x.title).join('、')];
    }
    return ['没找到「'+k+'」'];
  }

  const g=parseGoal(t);
  out.push(...autoPlan(g));
  return out;
}

/* ---------- 账本 ---------- */
const CATS=['吃饭','衣服','日用','娱乐','交通','学习','其他'];
function catOf(desc){
  const s=desc||'';
  if(/饭|餐|外卖|食堂|奶茶|咖啡|零食|水果|超市/.test(s))return '吃饭';
  if(/衣|裤|鞋|裙|外套|帽|袜|内衣/.test(s))return '衣服';
  if(/地铁|公交|打车|滴滴|火车|高铁|共享单车/.test(s))return '交通';
  if(/电影|游戏|会员|演出|门票|KTV|剧本/.test(s))return '娱乐';
  if(/书|文具|打印|复印|课程|题库/.test(s))return '学习';
  if(/洗|纸|巾|液|日用|快递/.test(s))return '日用';
  return '其他';
}
function moneyMonth(){
  const k=key(today).slice(0,7);
  return (S.money.entries||[]).filter(e=>(e.date||'').slice(0,7)===k);
}
